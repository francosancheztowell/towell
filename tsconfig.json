{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        // Solo sintaxis que se borra sin transformar: los tests de node importan .ts
        // con type-stripping y Vite/esbuild no necesitan emitir nada extra.
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        // Los imports relativos llevan .ts para que node los resuelva en los tests.
        "allowImportingTsExtensions": true
    },
    // Todo .ts nuevo queda tipado sin tener que registrarlo aqui.
    "include": ["resources/js/**/*.ts"],
    // tejido/inventario-telas.ts aun no pasa strict: lo tipa FE-06 (fase 15).
    "exclude": ["resources/js/tejido/**"]
}
