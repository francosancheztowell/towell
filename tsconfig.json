{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        // Los imports relativos llevan .ts para que node --test pueda cargar los
        // modulos directamente (tests/Js/*.test.mjs). Vite los resuelve igual.
        "allowImportingTsExtensions": true
    },
    "include": [
        "resources/js/trazabilidad/**/*.ts",
        "resources/js/crudo/**/*.ts",
        "resources/js/urd-eng/**/*.ts",
        "resources/js/programa-tejido/**/*.ts",
        "resources/js/programa-urd-eng/**/*.ts",
        "resources/js/utils/**/*.ts"
    ],
    "exclude": [
        "resources/js/programa-urd-eng/creacion-ordenes/index.ts"
    ]
}
