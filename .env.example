APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Conexiones SQL Server adicionales (producción). Definir el password aquí,
# NO en config/database.php (que se versiona).
# DB_PASSWORD_TIPRO=
# DB_PASSWORD_TOW_PRO=
# Refacciones EasyMaint (base Tow_Tow). Si no se definen, reusan host/usuario/password de TOW_PRO.
# DB_HOST_TOW_TOW=192.168.2.24
# DB_DATABASE_TOW_TOW=Tow_Tow
# DB_USERNAME_TOW_TOW=ax
# DB_PASSWORD_TOW_TOW=
# Ventas (app/Models/Ventas/*): conexion sqlsrv_Reportes_Towell, base ReportesTowel.
# La conexion debe existir en config/database.php (ver 10-01-SUMMARY.md, BASE-07).
# DB_HOST_REPORTES_TOWELL=
# DB_PORT_REPORTES_TOWELL=1433
# DB_DATABASE_REPORTES_TOWELL=
# DB_USERNAME_REPORTES_TOWELL=
# DB_PASSWORD_REPORTES_TOWELL=

# Produccion (Laragon, un solo servidor) usa file para sesion y cache (confirmado 2026-09-24).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Redbooth OAuth 2.0
CLIENT_ID=
CLIENT_SECRET=
REDBOOTH_REDIRECT_URI="${APP_URL}/integraciones/redbooth/callback"
REDBOOTH_AUTHORIZE_URL=https://redbooth.com/oauth2/authorize
REDBOOTH_TOKEN_URL=https://redbooth.com/oauth2/token
REDBOOTH_API_URL=https://redbooth.com/api/3
REDBOOTH_EXTERNAL_API_KEY=
REDBOOTH_EXTERNAL_USER_ID=

VITE_APP_NAME="${APP_NAME}"

# Correo transaccional vía Resend (SMTP, sin paquetes extra).
# MAIL_PASSWORD es la API key de Resend (re_...). El dominio de MAIL_FROM_ADDRESS
# debe estar verificado en Resend con los registros SPF/DKIM que entrega el panel.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="soporteti@towelmex.com"
MAIL_FROM_NAME="Reportes Towell"

# Destinatarios del reporte diario de telares (crudo:enviar-reporte), separados por coma.
CRUDO_REPORTE_CORREOS=

# Monitoreo (fase 11). Todo opcional: los valores por defecto sirven.
# MONITOREO_ENABLED=true
# Areas con acceso a /admin (CSV, sin acentos ni mayusculas importan).
# MONITOREO_AREAS_ADMIN=Sistemas
# Destinatario fijo de las alertas de errores nuevos/regresiones (por defecto francost15@gmail.com).
# Ojo: dejarla vacia (MONITOREO_ALERTA_CORREO=) APAGA las alertas; para el default, dejarla comentada.
# MONITOREO_ALERTA_CORREO=
