{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "towell/towell",
    "type": "project",
    "description": "Plataforma de planeación y control de producción para manufactura textil.",
    "keywords": [
        "laravel",
        "livewire",
        "sql-server",
        "manufacturing",
        "textile",
        "production-planning",
        "mes"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "dompdf/dompdf": "^3.1",
        "laravel/framework": "^12.0",
        "laravel/pulse": "^1.8",
        "laravel/tinker": "^3.0.2",
        "livewire/flux": "^2.20",
        "livewire/livewire": "^4.3",
        "maatwebsite/excel": "^3.1",
        "predis/predis": "^3.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.23",
        "icanhazstring/composer-unused": "^0.9.6",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/format_helpers.php",
            "app/Helpers/permission-helpers.php",
            "app/Helpers/device_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-autoload-dump": [
            "@php -r \"@unlink('bootstrap/cache/packages.php'); @unlink('bootstrap/cache/services.php');\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "quality": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/calidad.mjs pint",
            "@php vendor/bin/phpstan analyse --memory-limit=2G --no-progress",
            "node scripts/calidad.mjs phpmd",
            "npm run ratchet"
        ],
        "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-config.ps1 status",
        "db:unlock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-config.ps1 unlock",
        "db:lock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-config.ps1 lock",
        "db:save": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-config.ps1 save",
        "db:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-config.ps1 sync"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
